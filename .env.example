# Copy to .env.local and fill in. Every variable without a default is required at
# import time by src/server/env.ts, including during `next build`.
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://safarai:safarai@localhost:5432/safarai
REDIS_URL=redis://localhost:6379
# Must be at least 16 characters, and different from each other.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CLIENT_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GROQ_API_KEY=your-groq-api-key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_GENERATION=llama-3.3-70b-versatile
GROQ_MODEL_CHAT=llama-3.1-8b-instant
