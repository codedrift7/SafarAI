{
  "name": "safar-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "next build && npm run build:server",
    "start": "cross-env NODE_ENV=production node dist-server/server/index.js",
    "build:server": "tsc -p src/server/tsconfig.server.json && tsc-alias -p src/server/tsconfig.server.json",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "^15.1.3",
    "@prisma/client": "^6.13.0",
    "@radix-ui/react-slot": "^1.1.2",
    "argon2": "^0.41.1",
    "bullmq": "^5.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "openai": "^4.104.0",
    "puppeteer": "^24.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.4.49",
    "prisma": "^6.13.0",
    "tailwindcss": "^3.4.17",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
